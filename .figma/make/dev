#!/usr/bin/env bash
# Start the web dev server. Runs for the whole session; killed on project close.
set -euo pipefail

cd "$(dirname "$0")/../.."

# Load PORT / FIGMA_MAKE_URL from the env file next to this script.
set -a
# shellcheck disable=SC1091
source "$(dirname "$0")/env"
set +a

PORT="${PORT:-19006}"

# Old webpack 4 / metro use a hashing routine that OpenSSL 3 (Node 17+) rejects
# by default. This flag re-enables it.
export NODE_OPTIONS="--openssl-legacy-provider"

# Free the port in case a previous server was left behind.
if command -v lsof >/dev/null 2>&1; then
  lsof -ti:"$PORT" | xargs kill -9 2>/dev/null || true
fi

echo "Starting web dev server on http://localhost:$PORT ..."
exec node web-dev-server.js
